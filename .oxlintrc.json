{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.shopify/**",
    "**/generated/**",
    "examples/mock-http-server/**"
  ],
  "overrides": [
    {
      "files": ["**/*.{js,jsx}"],
      "rules": {
        "no-console": ["error", {"allow": ["error"]}],
        "no-debugger": "error"
      }
    }
  ]
}
