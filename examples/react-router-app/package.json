  "engines": {
    "node": ">=20.10"
  },
  "dependencies": {
    "@prisma/client": "6.13.0",
    "@react-router/dev": "7.8.1",
    "@react-router/fs-routes": "7.8.1",
    "@react-router/node": "7.8.1",
    "@react-router/serve": "7.8.1",
    "@shopify/app-bridge-react": "4.2.1",
    "@shopify/cli": "3.63.1",
    "@shopify/shopify-app-react-router": "0.1.1",
    "@shopify/shopify-app-session-storage-prisma": "6.0.0",
    "isbot": "5.1.29",
    "prisma": "6.13.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router": "7.7.1",
