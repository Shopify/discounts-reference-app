    "@typescript-eslint/parser": "8.37.0",
    "eslint": "9.31.0",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.28.1",
    "eslint-plugin-jsx-a11y": "6.7.1",
    "eslint-plugin-react": "7.33.2",
    "eslint-plugin-react-hooks": "5.2.0",
